DATABASE_URL=postgresql+psycopg2://snuser:snpass@localhost:5432/session_notes
UPLOAD_STORAGE_DIR=./data/uploads
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# --- rule-checking agent wiring ---
# Path to agent-making/, relative to this backend/ directory (or an
# absolute path) — app/agent_client.py needs this on sys.path to import
# agent.pipeline.api, since agent-making isn't an installed package.
AGENT_MAKING_PATH=../agent-making
# Real Anthropic/OpenRouter credentials the rule-checking pipeline needs
# to make its actual model calls. agent-making's own .env
# (agent-making/.env) already loads these independently the moment its
# code is imported — this is a belt-and-suspenders copy for a deploy that
# doesn't ship that second .env file.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Hard caps forwarded to every real review_person_document call — see
# agent-making/agent/pipeline/call_tracker.py for how these are enforced.
RULE_ENGINE_MAX_CALLS=50
RULE_ENGINE_MAX_SPEND_USD=4.00
